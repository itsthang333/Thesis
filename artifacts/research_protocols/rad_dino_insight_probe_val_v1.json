  "scientific_role": "image-label-only local/context heatmap mechanism probe; not a final pseudo-mask or consumer run",
  "hypothesis": "An INSIGHT-style local detector plus broad context suppression over frozen RAD-DINO patch tokens will preserve fine small-lesion evidence better than a per-patch linear MIL scorer while limiting anatomically broad false positives.",
  "literature_transfer": {
    "primary": "INSIGHT: Explainable Weakly-Supervised Medical Image Analysis",
    "citation": "Zhang, Chen and Kanan, MLHC 2025, PMLR 298",
    "url": "https://proceedings.mlr.press/v298/zhang25a.html",
    "transferred_mechanisms": [
      "spatial heatmap kept inside the aggregator",
      "small-kernel local detection branch",
      "broad-context suppression branch",
      "SmoothMax image-level pooling",
      "spectral-decoupling regularization"
    ],
    "explicit_deviations": [
      "frozen RAD-DINO radiograph patch tokens rather than the paper's modality-specific encoder",
      "depthwise-separable context convolution for T4 memory efficiency",
      "continuous diagnostic heatmaps; no Otsu or validation-fitted threshold",
      "fixed 448/320/280 BTXRD geometry and BTXRD split"
    ],
    "small_object_motivation": "Small Objects Matters in Weakly-Supervised Semantic Segmentation, WACV 2024",
